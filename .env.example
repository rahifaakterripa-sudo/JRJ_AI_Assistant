# ============================================================
# JRJ AI Assistant - Backend Environment Configuration
# ============================================================

# Gemini Vision API Key (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model for chart vision reasoning (fast & precise)
GEMINI_MODEL=gemini-2.5-flash

# Telegram Bot Credentials for Bengali Chart Reports
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Security Bearer Secret Key for Android Client -> Backend requests
API_SECRET_KEY=replace_with_a_random_server_secret

# Default Market Web URL loaded in Android WebView
DEFAULT_MARKET_URL=https://market-qx.info/en/trade

# Analysis & Network Settings
ANALYSIS_BUDGET_SECONDS=80
ANALYSIS_RESPONSE_RESERVE_SECONDS=5
MAX_CONCURRENT_ANALYSES=4
HOST=0.0.0.0
PORT=8000
